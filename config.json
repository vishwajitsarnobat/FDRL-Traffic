{
  "environment": {
    "sumo_cfg": "path/to/your/network.sumocfg",
    "intersection_ids": ["your_intersection_id"],
    "use_gui": false,
    "max_steps": 3600,
    "phase_duration": 30,
    "yellow_duration": 3
  },
  "agent": {
    "state_dim": 8,
    "action_dim": 4,
    "lr_actor": 0.0001,
    "lr_critic": 0.001,
    "gamma": 0.9,
    "epsilon": 0.2,
    "device": "cpu"
  },
  "federated": {
    "update_frequency": 10,
    "alpha": 0.1,
    "aggregation_strategy": "flexible",
    "communication_rounds": 100
  },
  "training_episodes": 200,
  "test_episodes": 10,
  "fixed_phase_duration": 30,
  "save_dir": "./checkpoints"
}